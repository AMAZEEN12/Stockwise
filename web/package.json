{
  "name": "stockwise-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "mock": "node scripts/mock-api.mjs",
    "mock:prepare": "node scripts/mock-api.mjs --prepare-only",
    "check:mock": "node scripts/check-mock.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript ../contract/openapi.yaml -o src/api/schema.d.ts",
    "lint:contract": "redocly lint ../contract/openapi.yaml --config ../contract/redocly.yaml"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-toast": "1.3.1",
    "@reduxjs/toolkit": "2.13.0",
    "@tailwindcss/vite": "4.3.3",
    "axios": "1.20.0",
    "clsx": "2.1.1",
    "formik": "2.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.0",
    "react-router": "7.18.4",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "yup": "1.7.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "2.71.0",
    "@stoplight/prism-cli": "5.16.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "26.1.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  }
}
